<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local-ai.ollama</string>

    <key>ProgramArguments</key>
    <array>
        <string>@@OLLAMA_BIN@@</string>
        <string>serve</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@@PATH@@</string>
        <key>HOME</key>
        <string>@@HOME@@</string>
        <!-- Loopback only: the model server is not exposed to the network. -->
        <key>OLLAMA_HOST</key>
        <string>127.0.0.1:11434</string>
        <!-- Flash attention plus a quantised KV cache roughly halves the memory
             a long context costs, which is what makes big contexts viable on a
             16GB machine. -->
        <key>OLLAMA_FLASH_ATTENTION</key>
        <string>1</string>
        <key>OLLAMA_KV_CACHE_TYPE</key>
        <string>q8_0</string>
        <!-- Keep the weights resident so the second message is not another
             cold load from disk. -->
        <key>OLLAMA_KEEP_ALIVE</key>
        <string>30m</string>
        <key>OLLAMA_MAX_LOADED_MODELS</key>
        <string>@@MAX_LOADED_MODELS@@</string>
        <key>OLLAMA_NUM_PARALLEL</key>
        <string>1</string>
        <key>OLLAMA_CONTEXT_LENGTH</key>
        <string>@@NUM_CTX@@</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>@@LOG_DIR@@/ollama.log</string>
    <key>StandardErrorPath</key>
    <string>@@LOG_DIR@@/ollama.log</string>
</dict>
</plist>
