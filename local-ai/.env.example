# Copy to local-ai/.env and fill in. This file is git-ignored -- never commit
# the real one, and never paste the token into a chat window.
#
#   cp local-ai/.env.example local-ai/.env
#   chmod 600 local-ai/.env

# ---------------------------------------------------------------- required --

# From @BotFather on Telegram (/newbot, or /token for an existing bot).
TELEGRAM_BOT_TOKEN=REPLACE_ME

# Comma-separated numeric Telegram user IDs allowed to talk to the bot.
# Anyone else gets a polite refusal. Message the bot /whoami to find yours,
# or ask @userinfobot. Leaving this empty locks everybody out.
TELEGRAM_ALLOWED_USER_IDS=

# ---------------------------------------------------------------- models ----

# The default model. Change per-chat at runtime with /model.
LOCAL_AI_MODEL=qwen3:8b

# Used when you send a photo and the default model cannot see. Leave empty to
# always use the default model.
LOCAL_AI_VISION_MODEL=

# Prepended to every conversation. Empty means the model's own default.
LOCAL_AI_SYSTEM_PROMPT=

# ---------------------------------------------------------------- tuning ----

OLLAMA_HOST=http://127.0.0.1:11434

# 0 is focused and repeatable, 1+ is loose and creative.
LOCAL_AI_TEMPERATURE=0.7

# Context window in tokens. Bigger costs memory -- 8192 is comfortable on
# 16GB, 16384+ is fine on 32GB and up.
LOCAL_AI_NUM_CTX=8192

# Sliding window over past messages: at most this many, and this many chars.
LOCAL_AI_HISTORY_TURNS=24
LOCAL_AI_HISTORY_CHARS=24000

# Seconds between edits of the streaming message. Below ~1.0 Telegram starts
# rate-limiting.
LOCAL_AI_STREAM_INTERVAL=1.1

# Show a reasoning model's scratchpad while it thinks.
LOCAL_AI_SHOW_THINKING=0

# Transcribe voice notes (needs mlx-whisper or whisper, plus ffmpeg).
LOCAL_AI_VOICE=1
LOCAL_AI_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# Largest photo/file to accept, in MB (Telegram caps bot downloads at 20).
LOCAL_AI_MAX_FILE_MB=20

# Where the SQLite conversation database lives.
# LOCAL_AI_DATA_DIR=~/.local/share/local-ai

# DEBUG for verbose logs.
LOCAL_AI_LOG_LEVEL=INFO
